{
  "config_version": 1,
  "control_plane": {
    "base_url": "https://api.openai.com",
    "tunnel_id": "<TUNNEL_ID>",
    "api_key": "file:/Users/you/.config/openai/runtime-api-key"
  },
  "health": {
    "listen_addr": "127.0.0.1:0",
    "url_file": "/Users/you/Library/Application Support/tunnel-client/health/local-codex.url"
  },
  "admin_ui": {
    "open_browser": false
  },
  "log": {
    "level": "info",
    "format": "json",
    "file": "/Users/you/Library/Application Support/tunnel-client/logs/local-codex.log"
  },
  "mcp": {
    "server_urls": [
      {
        "channel": "main",
        "url": "http://127.0.0.1:8765/mcp"
      }
    ],
    "extra_headers": {
      "Authorization": "file:/Users/you/Library/Application Support/local-codex-tunnel/adapter-token"
    },
    "discovery_extra_headers": {
      "Authorization": "file:/Users/you/Library/Application Support/local-codex-tunnel/adapter-token"
    }
  }
}
